<?xml version="1.0"?>
<robot name="humanoid_robot">

  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="purple"><color rgba="0.5 0 0.7 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>
  <material name="skin"><color rgba="1 0.60 0.0 1"/></material>
  <material name="green_900"><color rgba="0.0 0.3 0.0 1.0"/></material>  
  <material name="brown"><color rgba="0.45 0.25 0.0 1.0"/></material>

  <link name="world"/>

  <link name="table_top_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="1.5 1.0 0.05"/></geometry> <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="1.5 1.0 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_top_link"/>
    <origin xyz="0 0 0.8" rpy="0 0 0"/> 
  </joint>

  <link name="leg_1"><visual><origin xyz="0 0 -0.4"/><geometry><cylinder radius="0.03" length="0.8"/></geometry><material name="black"/></visual></link>
  <joint name="leg_1_joint" type="fixed"><parent link="table_top_link"/><child link="leg_1"/><origin xyz="0.7 0.45 -0.025"/></joint>

  <link name="leg_2"><visual><origin xyz="0 0 -0.4"/><geometry><cylinder radius="0.03" length="0.8"/></geometry><material name="black"/></visual></link>
  <joint name="leg_2_joint" type="fixed"><parent link="table_top_link"/><child link="leg_2"/><origin xyz="-0.7 0.45 -0.025"/></joint>

  <link name="leg_3"><visual><origin xyz="0 0 -0.4"/><geometry><cylinder radius="0.03" length="0.8"/></geometry><material name="black"/></visual></link>
  <joint name="leg_3_joint" type="fixed"><parent link="table_top_link"/><child link="leg_3"/><origin xyz="0.7 -0.45 -0.025"/></joint>

  <link name="leg_4"><visual><origin xyz="0 0 -0.4"/><geometry><cylinder radius="0.03" length="0.8"/></geometry><material name="black"/></visual></link>
  <joint name="leg_4_joint" type="fixed"><parent link="table_top_link"/><child link="leg_4"/><origin xyz="-0.7 -0.45 -0.025"/></joint>

  <link name="body_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry><box size="0.7 0.08 0.7"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.7 0.08 0.7"/></geometry>
    </collision>
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="table_to_robot_joint" type="fixed">
    <parent link="table_top_link"/>
    <child link="body_base_link"/>
    <origin xyz="0 0 0.375" rpy="0 0 0"/> 
  </joint>

  <link name="head_link">
    <visual><geometry><box size="0.2 0.2 0.2"/></geometry><material name="green_900"/></visual>
  </link>
  <joint name="body_to_head_joint" type="fixed">
    <parent link="body_base_link"/><child link="head_link"/><origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>

  <link name="arm_base_link_right"><visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual></link>
  <joint name="body_to_arm_joint_right" type="revolute">
    <parent link="body_base_link"/><child link="arm_base_link_right"/>
    <origin xyz="0.35 0.04 0.3" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.18" effort="10" velocity="1"/>
  </joint>

  <link name="upper_arm_link_right"><visual><origin xyz="0.15 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.05" length="0.3"/></geometry><material name="purple"/></visual></link>
  <joint name="shoulder_yaw_joint_right" type="revolute"><parent link="arm_base_link_right"/><child link="upper_arm_link_right"/><axis xyz="0 0 1"/><limit lower="-1.57" upper="-0.39" effort="10" velocity="1"/></joint>

  <link name="forearm_link_right"><visual><origin xyz="0.125 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="0.25"/></geometry><material name="green"/></visual></link>
  <joint name="shoulder_pitch_joint_right" type="revolute"><parent link="upper_arm_link_right"/><child link="forearm_link_right"/><origin xyz="0.3 0 0"/><axis xyz="0 1 0"/><limit lower="-0.025" upper="1.73" effort="10" velocity="1"/></joint>

  <link name="wrist_link_right"><visual><origin xyz="0.045 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="0.09"/></geometry><material name="black"/></visual></link>
  <joint name="elbow_joint_right" type="revolute"><parent link="forearm_link_right"/><child link="wrist_link_right"/><origin xyz="0.25 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="1.57" effort="10" velocity="1"/></joint>

  <link name="finger_link_right"><visual><origin xyz="0.09 0 0" rpy="0 -1.5708 0"/><geometry><box size="0.02 0.02 0.09"/></geometry><material name="skin"/></visual></link>
  <joint name="finger_joint_right" type="fixed"><parent link="wrist_link_right"/><child link="finger_link_right"/></joint>

  <link name="arm_base_link_left"><visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual></link>
  <joint name="body_to_arm_joint_left" type="revolute">
    <parent link="body_base_link"/><child link="arm_base_link_left"/>
    <origin xyz="-0.35 0.04 0.3" rpy="0 0 3.14159"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.18" effort="10" velocity="1"/>
  </joint>

  <link name="upper_arm_link_left"><visual><origin xyz="0.15 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.05" length="0.3"/></geometry><material name="purple"/></visual></link>
  <joint name="shoulder_yaw_joint_left" type="revolute"><parent link="arm_base_link_left"/><child link="upper_arm_link_left"/><axis xyz="0 0 1"/><limit lower="0.0" upper="1.57" effort="10" velocity="1"/></joint>

  <link name="forearm_link_left"><visual><origin xyz="0.125 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="0.25"/></geometry><material name="green"/></visual></link>
  <joint name="shoulder_pitch_joint_left" type="revolute"><parent link="upper_arm_link_left"/><child link="forearm_link_left"/><origin xyz="0.3 0 0"/><axis xyz="0 1 0"/><limit lower="-0.025" upper="1.57" effort="10" velocity="1"/></joint>

  <link name="wrist_link_left"><visual><origin xyz="0.045 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="0.09"/></geometry><material name="black"/></visual></link>
  <joint name="elbow_joint_left" type="revolute"><parent link="forearm_link_left"/><child link="wrist_link_left"/><origin xyz="0.25 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="1.57" effort="10" velocity="1"/></joint>

  <link name="finger_link_left"><visual><origin xyz="0.09 0 0" rpy="0 -1.5708 0"/><geometry><box size="0.02 0.02 0.09"/></geometry><material name="skin"/></visual></link>
  <joint name="finger_joint_left" type="fixed"><parent link="wrist_link_left"/><child link="finger_link_left"/></joint>

<link name="eye_right">
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>

  <joint name="head_to_eye_right" type="fixed">
    <parent link="head_link"/>
    <child link="eye_right"/>
    <origin xyz="0.05 -0.1 0.05" rpy="0 0 0"/>
  </joint>

  <link name="eye_left">
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
  </link>

  <joint name="head_to_eye_left" type="fixed">
    <parent link="head_link"/>
    <child link="eye_left"/>
    <origin xyz="-0.05 -0.1 0.05" rpy="0 0 0"/>
  </joint>

  <link name="pupil_right">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="eye_to_pupil_right" type="fixed">
    <parent link="eye_right"/>
    <child link="pupil_right"/>
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
  </joint>

  <link name="pupil_left">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="eye_to_pupil_left" type="fixed">
    <parent link="eye_left"/>
    <child link="pupil_left"/>
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
  </joint>



</robot>
